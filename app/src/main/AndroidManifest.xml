<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ══════════════════════════════════════════════════════════
         실기기 검증(SM-S937N / Android 16)에서 전부 정상 동작 확인됨
         ══════════════════════════════════════════════════════════ -->

    <!-- 통화녹음 파일 읽기. 이 서비스의 핵심 권한 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 통화 종료 감지 + 수신/발신 구분 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      등록된 가족이 이 폰에 어떤 이름으로 저장돼 있는지 조회합니다.
      통화 녹음 파일명이 그 이름으로 나오기 때문에 필요합니다.
      (예: 우리 시스템 "김서연" → 이 폰 연락처 "큰딸")

      PhoneLookup 으로 특정 번호만 역조회하며,
      조회 결과는 단말에만 두고 서버로 보내지 않습니다.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 목소리 등록 시에만 사용 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 위험 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 서버 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 백그라운드 감시 (P1에서 추가) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      READ_CALL_LOG 은 의도적으로 넣지 않습니다.
      Play 정책상 기본 전화앱/어시스턴트에만 허용되며, 심사에서 거절됩니다.
      발신자 정보는 통화녹음 파일명에서 얻습니다. (실측 검증 완료)
        통화 막내딸_260809_133433.m4a  → 연락처명
        통화 01076352857_260809_135255.m4a → 번호
    -->

    <application
        android:name=".core.IsFamApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IsFAM">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.IsFAM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          PHONE_STATE 는 시스템이 앱을 깨워주는 브로드캐스트입니다.
          상시 실행 서비스 없이도 통화 종료를 감지할 수 있습니다.
          무거운 작업은 WorkManager 로 넘깁니다.
        -->
        <receiver
            android:name=".core.call.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>