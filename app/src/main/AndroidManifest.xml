<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ══════════════════════════════════════════════════════════
         실기기 검증(SM-S937N / Android 16)에서 전부 정상 동작 확인됨
         ══════════════════════════════════════════════════════════ -->

    <!-- 통화녹음 파일 읽기. 이 서비스의 핵심 권한 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 통화 종료 감지 + 수신/발신 구분 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 목소리 등록 시에만 사용 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 위험 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 서버 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 백그라운드 감시 (P1에서 추가) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      READ_CALL_LOG 은 의도적으로 넣지 않습니다.
      Play 정책상 기본 전화앱/어시스턴트에만 허용되며, 심사에서 거절됩니다.
      발신자 정보는 통화녹음 파일명에서 얻습니다. (실측 검증 완료)
        통화 막내딸_260809_133433.m4a  → 연락처명
        통화 01076352857_260809_135255.m4a → 번호
    -->

    <application
        android:name=".core.IsFamApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IsFAM">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.IsFAM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P1에서 추가할 서비스·리시버 (Probe 코드 이관)
        <service
            android:name=".core.call.CallWatcherService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver android:name=".core.call.PhoneStateReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        -->
    </application>
</manifest>